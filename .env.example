# FlashTicket 生产环境变量（复制为 .env 后修改，.env 不入版本库）
# 用法：cp .env.example .env && vim .env

# MySQL root 密码（MySQL 容器与后端共用，建议 24 位以上随机串）
DB_PASSWORD=ChangeMe_MySQL_2026

# 初始超级管理员（仅当库中没有有效超管时创建；密码长度须 12-64 位）
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@flashticket.local
SUPER_ADMIN_PASSWORD=ChangeMe_SuperAdmin_2026

# 对外端口（云厂商安全组 + 1Panel 防火墙都要放行）
WEB_PORT=8080
ADMIN_PORT=8081
