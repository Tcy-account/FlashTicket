# FlashTicket 环境变量示例（复制为 .env 后修改；.env 已 gitignore，勿提交真实口令）
# 用法：cp .env.example .env   （Windows: Copy-Item .env.example .env）
#
# 本地 docker compose up -d 会读取同目录 .env；未设置时 docker-compose.yml 使用 changeme 占位默认值。
# 生产（docker-compose.prod.yml）要求 DB_PASSWORD / SUPER_ADMIN_PASSWORD 必填，无占位默认。

# ---- MySQL（本地 compose + 后端 spring.datasource）----
# 建议 24 位以上随机串；本地示例占位请务必改掉再对外暴露端口
DB_PASSWORD=changeme

# ---- 初始超级管理员（仅当库中没有有效超管时由 SuperAdminBootstrap 创建）----
# 密码长度须 12-64 位，且不要用常见弱口令
SUPER_ADMIN_ENABLED=true
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@flashticket.local
SUPER_ADMIN_PASSWORD=ChangeMe_SuperAdmin_LocalOnly

# ---- Grafana（仅本地 docker-compose.yml 监控栈）----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# ---- E2E / 压测（可选；未设置时脚本使用明显测试占位，见 e2e/）----
# E2E_SUPERADMIN_PASSWORD=ChangeMe_SuperAdmin_LocalOnly

# ---- 生产对外端口（docker-compose.prod.yml；云厂商安全组 + 防火墙放行）----
WEB_PORT=8080
ADMIN_PORT=8081