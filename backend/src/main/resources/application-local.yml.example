# FlashTicket 本地环境配置示例
# 复制为 application-local.yml（已在 .gitignore 排除，敏感值不入版本库），
# 或直接使用环境变量覆盖 application.yml 中的默认值。

spring:
  datasource:
    url: jdbc:mysql://localhost:33061/flashticket?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
    username: root
    password: "changeme"
  data:
    redis:
      host: localhost
      port: 16379
      password: ""
