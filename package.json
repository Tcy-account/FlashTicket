{
  "name": "flashticket",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @flashticket/ticket-web --filter @flashticket/admin-web dev",
    "dev:web": "pnpm --filter @flashticket/ticket-web dev",
    "dev:admin": "pnpm --filter @flashticket/admin-web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --parallel --filter @flashticket/ticket-web --filter @flashticket/admin-web typecheck"
  }
}
